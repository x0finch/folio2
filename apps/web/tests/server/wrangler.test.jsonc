{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folio-web-server-test",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  // Workers-pool tests only: D1 binding without the app's main/crons/cache/vars; migrations are injected via readD1Migrations.
  // Fixed fake key (32 bytes, base64) so tests can assert secret fields are sealed and public ones are not.
  "vars": {
    "SECRETS_KEY": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "folio",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
