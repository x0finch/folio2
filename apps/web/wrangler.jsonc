{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folio-web",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // 非密环境变量(明文、随 git 提交)。密钥(SECRETS_KEY/BETTER_AUTH_*/各 provider key)走
  // `wrangler secret put`,绝不进这里。LOG_PRETTY 生产不设 → JSON Lines 喂 Workers Logs(见 DEPLOY.md)。
  "vars": { "LOG_LEVEL": "info" },
  // Workers Cache:边缘缓存 Worker 返回的响应(logo 代理靠它,见 ADR 0008)。按 Cache-Control 头控制。
  "cache": { "enabled": true },
  // CF 账户 id(资源标识,非密钥)。
  "account_id": "2bce8216267cf76d85fab3ce18abea69",

  // D1 绑定:auth handler 取数据用。迁移文件在 @folio/db 包;database_id 由 `wrangler d1 create folio` 得到(资源 id,非密钥;见 DEPLOY.md)。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "folio",
      "database_id": "c053dd80-abfa-47d5-8262-01f001e68924",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],

  // 两个定时任务,**刻意拆成两个 trigger**(ADR 0022 / #199):
  //   · 23:00 —— 刷全局代币映射表(拉几 MB JSON + 写几万行,重活)
  //   · 00:00 —— 全量 sync sweep
  // 挤一次调用有超预算风险,而且刷表卡住会拖到 sync 跑不完;拆开则各自一份 CPU / 时间预算,
  // 且刷表先跑完、sync 当天就能用上新数据。src/server.ts 的 scheduled() 按 controller.cron 分支。
  "triggers": { "crons": ["0 23 * * *", "0 0 * * *"] },

  // 可观测性(P6.7):开启 Workers Logs —— 自动摄取 console.* / LogTape 的 console sink 输出,
  // JSON 自动抽成可索引字段(Dashboard Query Builder + wrangler tail)。单用户 → 全量采样。
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
