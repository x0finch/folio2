{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folio-web",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // D1 绑定:auth handler 取数据用。迁移文件在 @folio/db 包;database_id 占位,部署时填(P6.6)。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "folio",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],

  // 定时同步(P6.3):每日 UTC 00:00 触发 src/server.ts 的 scheduled() 跑全量 sweep。
  "triggers": { "crons": ["0 0 * * *"] },

  // 可观测性(P6.7):开启 Workers Logs —— 自动摄取 console.* / LogTape 的 console sink 输出,
  // JSON 自动抽成可索引字段(Dashboard Query Builder + wrangler tail)。单用户 → 全量采样。
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
