{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folio",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Secrets go through `wrangler secret put`, never here.
  "vars": { "LOG_LEVEL": "info" },
  // Edge-caches Worker responses (the logo proxy relies on it); controlled by Cache-Control.
  "cache": { "enabled": true },
  "account_id": "2bce8216267cf76d85fab3ce18abea69",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "folio",
      "database_id": "8f62b220-d84e-43e6-b07e-ecb3edb655cb",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],

  // Two separate crons: the daily per-user jobs at 23:00, and the hourly sync sweep at :30.
  // The sweep avoids the top of the hour so it doesn't fire alongside the 23:00 trigger
  // (tests/cron-triggers.test.ts pins this). It only starts a round and enqueues jobs; upstream
  // calls happen in the job runner. Hourly gives the 24h PnL segmentation more snapshot cut points.
  "triggers": { "crons": ["0 23 * * *", "30 * * * *"] },

  // Background job runner. Free plan gives each HTTP / cron call only 10ms CPU while one
  // `sync-account` takes ~50ms, so cron / server fns only enqueue into this Durable Object and its
  // alarm runs one job at a time (src/lib/server/jobs/durable.ts; 50 subrequests per invocation).
  // Free plan requires SQLite-backed DOs. `durable_objects` is not inherited by envs: test and
  // preview each repeat it (tests/runner-config.test.ts pins this); `migrations` is shared.
  "durable_objects": {
    "bindings": [{ "name": "JOB_RUNNER", "class_name": "JobRunner" }]
  },
  "migrations": [{ "tag": "v1-job-runner", "new_sqlite_classes": ["JobRunner"] }],

  // Navigations are served from the prerendered `index.html` (vite.config.ts SPA mode) and never
  // reach the Worker; only the `run_worker_first` prefixes do (`/cdn-cgi/*` is for local
  // `wrangler dev` cron). Not inherited by envs: test / preview repeat it, else navigation falls
  // back to Worker SSR. `directory` is filled in by @cloudflare/vite-plugin at build.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/_serverFn/*", "/cdn-cgi/*"]
  },

  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // e2e-only env: it exists so `.dev.vars.test` is loaded (Binance pointed at a local fake).
  // Selected via `CLOUDFLARE_ENV=test` (playwright.config.ts). Envs don't inherit top-level
  // config, so bindings are repeated. The database_id is deliberately different: Miniflare keys
  // the local SQLite file off the id, so e2e gets its own database (run `pnpm db:migrate:e2e`).
  // The id doesn't exist on Cloudflare: use it with `--local` only, never deploy or migrate
  // `--remote` with `--env test`.
  "env": {
    "test": {
      "vars": { "LOG_LEVEL": "warning" },
      "cache": { "enabled": true },
      "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/_serverFn/*", "/cdn-cgi/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "folio-e2e",
          "database_id": "e2e00000-0000-4000-8000-000000000372",
          "migrations_dir": "../../packages/db/drizzle"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "JOB_RUNNER", "class_name": "JobRunner" }]
      },
      "observability": { "enabled": true, "head_sampling_rate": 1 }
    },

    // PR preview env, deployed with `--env preview` as a separate Worker `folio-preview` that all
    // PRs share along with its remote D1 (see DEPLOY.md). No cron triggers, but the job runner is
    // kept because manual sync needs it. Envs don't inherit top-level config, so bindings/vars are
    // repeated. Secrets are set per Worker with `wrangler secret put --env preview`.
    "preview": {
      // Must be explicit: without a name the env reuses `folio` and `deploy --env preview` would
      // overwrite the production Worker (service environments were removed in wrangler v4).
      "name": "folio-preview",
      // Per-PR preview URLs via `wrangler versions upload --preview-alias pr-<N>`.
      "preview_urls": true,
      "vars": {
        "LOG_LEVEL": "info",
        // Extra trusted origins (better-auth trustedOrigins) so workers.dev preview aliases pass
        // CSRF/Origin checks; unset in production.
        "PREVIEW_TRUSTED_ORIGINS": "https://*-folio-preview.*.workers.dev"
      },
      "cache": { "enabled": true },
      "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/_serverFn/*", "/cdn-cgi/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "folio-preview",
          "database_id": "3564a2e0-d932-4368-bb3a-40c272ae047f",
          "migrations_dir": "../../packages/db/drizzle"
        }
      ],
      // Own job runner: a different Worker has its own DO namespace, independent of production.
      "durable_objects": {
        "bindings": [{ "name": "JOB_RUNNER", "class_name": "JobRunner" }]
      },
      "observability": { "enabled": true, "head_sampling_rate": 1 }
    }
  }
}
