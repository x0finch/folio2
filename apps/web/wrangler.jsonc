{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folio",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // 非密环境变量(明文、随 git 提交)。密钥(SECRETS_KEY/BETTER_AUTH_*/各 provider key)走
  // `wrangler secret put`,绝不进这里。LOG_PRETTY 生产不设 → JSON Lines 喂 Workers Logs(见 DEPLOY.md)。
  "vars": { "LOG_LEVEL": "info" },
  // Workers Cache:边缘缓存 Worker 返回的响应(logo 代理靠它,见 ADR 0008)。按 Cache-Control 头控制。
  "cache": { "enabled": true },
  // CF 账户 id(资源标识,非密钥)。
  "account_id": "2bce8216267cf76d85fab3ce18abea69",

  // D1 绑定:auth handler 取数据用。迁移文件在 @folio/db 包;database_id 由 `wrangler d1 create folio` 得到(资源 id,非密钥;见 DEPLOY.md)。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "folio",
      "database_id": "8f62b220-d84e-43e6-b07e-ecb3edb655cb",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],

  // 两个定时任务,**刻意拆成两个 trigger**(ADR 0022 / #199):
  //   · 每天 23:00 整 —— 投每天的逐用户活(`prune-notes` / `catalogue`,FOL-88,只投不跑)
  //   · 每小时 30 分 —— 全量 sync sweep(#446)。**FOL-86 起它只开轮 + 投活**(见下面 `durable_objects`),
  //     不在这一次调用里碰上游;每个账户的同步各自是运行器的一次 alarm。
  // src/server.ts 的 scheduled() 按 controller.cron 分支。
  //
  // **全局代币映射表不在这里刷了**(FOL-85,ADR 0056):拉 2.6 MB 币目录 + 与几万行比对,生产
  // 480–520ms CPU、免费计划一次调用只有 10ms。它现在是 GitHub Actions 的一个定时 workflow
  // (`.github/workflows/ref-index-refresh.yml`,同样每天 23:00 UTC),经 D1 REST API 写这个库。
  //
  // **sweep 落在半点而不是整点**:整点的话每天 23:00 会与上面那条同时触发 —— Workers 各起一次
  // scheduled 调用、各自投一遍活。这条约束由 tests/cron-triggers.test.ts 锁着。
  //
  // **为什么提到每小时**(#446):24h 盈亏按快照分段算(ADR 0040),每次同步就是一个切口,
  // 切口越密越准。一天一张照片 = 没得切,分段法永远退化成「按 24 小时前的数量算」。
  // 存储代价按单账户量过(见 #446 的评估):每账户每年 ≈ 1.5 MB + 3.1 MB × 持币数,
  // 带 account 级 note 的账户另加约 37 MB —— note 每次同步原样重存,去重是 #456。
  "triggers": { "crons": ["0 23 * * *", "30 * * * *"] },

  // 后台任务运行器(FOL-100,ADR 0058;取代 FOL-86 的 Cloudflare 队列)。**免费计划每次 HTTP / cron /
  // 队列调用只有 10ms CPU**,而一条 `sync-account` 本地实测约 50ms —— 所以活不在那些调用里跑:
  // cron / server fn 只往这个 Durable Object 里投(`enqueue`),DO 把活排在自己的 SQLite 里,alarm
  // 一次跑一件(src/lib/server/jobs/durable.ts)。DO 每次调用(含 alarm)默认 30s CPU —— **免费计划上是否
  // 同样如此,文档说法不一,上线后按 Workers Logs 的 outcome 实测**(FOL-100;ADR 0058「前提」)。
  //   · 一次 alarm 一件:每次调用 50 个外部 subrequest 的上限照旧,活已按它切好(FOL-86)。
  //   · 重试由运行器自己排(指数退避 30s → 60s → 120s,jobs/constants.ts),最后一次仍失败时 consumer
  //     先收尾(账户记 failed)、运行器把那一行**埋掉**留给人看 —— 等价于以前的死信队列。
  //   · 只有一个实例、单线程:所有用户的活排在一条线上(以前是 `max_concurrency: 6`)。
  // 免费计划只能用 SQLite 存储的 DO(`new_sqlite_classes`)。DO 不必事先 create:部署时按下面的
  // `migrations` 建出来。**`durable_objects` 在 env 里不继承**,test / preview 各有一份(tests/runner-config.test.ts 锁着);
  // `migrations` 是顶层的,各 env 共用。
  "durable_objects": {
    "bindings": [{ "name": "JOB_RUNNER", "class_name": "JobRunner" }]
  },
  "migrations": [{ "tag": "v1-job-runner", "new_sqlite_classes": ["JobRunner"] }],

  // 静态资源路由(ADR 0049 补记):HTML 文档是构建期 prerender 出的 `index.html`(vite.config.ts 的
  // SPA 模式),**导航请求不进 Worker**。没命中文件的路径一律回 index.html(SPA 兜底),
  // 只有 run_worker_first 这几条前缀先给 Worker:API 路由、server fn、以及 wrangler dev 的 cron 入口。
  // 线上 cron 直接进 `scheduled()`,不经 fetch,那条只为本地方便。
  // `directory` 不写:@cloudflare/vite-plugin 在构建产物的 wrangler.json 里补上(指向 ../client)。
  // **env 里不继承**,下面 test / preview 各抄一份 —— 少一份的症状是那个环境的导航又回到 Worker SSR。
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/_serverFn/*", "/cdn-cgi/*"]
  },

  // 可观测性(P6.7):开启 Workers Logs —— 自动摄取 console.* / LogTape 的 console sink 输出,
  // JSON 自动抽成可索引字段(Dashboard Query Builder + wrangler tail)。单用户 → 全量采样。
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // e2e 专用环境(#372)。**它存在的唯一理由**是让 `.dev.vars.test` 生效 —— Cloudflare 插件只在
  // 选中某个 Cloudflare environment 时才去找 `.dev.vars.<env>`,而那份文件把 Binance 指向本地假
  // server。由 `CLOUDFLARE_ENV=test` 选中(见 playwright.config.ts 的 webServer)。
  //
  // 顶层配置在 env 里**不继承**,所以绑定要原样重列一遍。
  //
  // D1 **刻意换了一个 database_id**,于是 e2e 跑在自己的本地库上。Miniflare 按 id 定位本地那个
  // SQLite 文件(CLAUDE.md 记着这条),所以换 id 就等于换库。理由是隔离:e2e 每轮都注册用户、造账户、
  // 写快照,没道理堆进开发用的那个库里,也没道理让测试有机会碰到开发数据。
  // (顺便说清:这**不是**为了性能。本地那个库堆到 10MB 之后量过一遍,整套 e2e 的耗时没有变化。)
  // 代价是这个库也要迁移一次:`pnpm db:migrate:e2e`(CI 里那一步同样跑它)。
  // 这个 id 只是本地文件名的 key,**在 Cloudflare 上并不存在** —— 它永远只配 `--local` 用,
  // 别拿 `--env test` 去 deploy 或 `--remote` 迁移。
  "env": {
    "test": {
      "vars": { "LOG_LEVEL": "warning" },
      "cache": { "enabled": true },
      "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/_serverFn/*", "/cdn-cgi/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "folio-e2e",
          "database_id": "e2e00000-0000-4000-8000-000000000372",
          "migrations_dir": "../../packages/db/drizzle"
        }
      ],
      // 运行器在本地由 Miniflare 模拟(alarm 照样会响)。
      "durable_objects": {
        "bindings": [{ "name": "JOB_RUNNER", "class_name": "JobRunner" }]
      },
      "observability": { "enabled": true, "head_sampling_rate": 1 }
    },

    // PR preview 环境(见 .github/workflows/pr-preview.yml + DEPLOY.md「PR preview」一节)。
    // 用 `--env preview` 部署到一个**独立的** Worker `folio-preview`(name 继承顶层 `folio` +
    // env 后缀),URL 固定为 https://folio-preview.<你的子域>.workers.dev —— **生产 Worker
    // `folio` 完全不受影响**,不是它的一个 version,是另一个 Worker。
    //
    // 所有 PR **共用**这一个 preview Worker + 下面这个 `folio-preview` 远程库(方案 B:常驻累积)。
    // 后 push 的 PR 覆盖前一个的活跃版本;pr-preview.yml 用 concurrency 串行化兜底。
    // 库平时不清、保留数据/登录态;只有极少数 destructive 迁移把某个 preview 弄崩时,手动跑
    // preview-reset.yml 重建一次(那次数据丢)。
    //
    // ⚠️ **不带 triggers** —— preview 不需要 cron(不跑定时刷表/同步,免得偷打上游)。
    // (运行器照带:没有 cron 就没人往里投定时的活,但手动同步要它,见下面 `durable_objects`。)
    // 顶层配置在 env 里不继承,所以绑定/vars 要原样重列。
    // BETTER_AUTH_URL / SECRETS_KEY / BETTER_AUTH_SECRET / COINSTATS_API_KEY 这些密钥由
    // `wrangler secret put --env preview` 一次性设在 `folio-preview` Worker 上(见 DEPLOY.md),
    // CI 不碰。BETTER_AUTH_URL 设成上面那个固定 preview URL,better-auth 因而同源、无需改动。
    "preview": {
      // 独立 Worker 名 —— **必须显式写**。wrangler v4 已移除 service environments:env 不给 name
      // 就沿用顶层 `folio`,`deploy --env preview` 会直接覆盖生产 Worker(踩过一次,见 DEPLOY.md)。
      "name": "folio-preview",
      // per-PR 预览:每个打了 `preview` 标签的 PR 经 `wrangler versions upload --preview-alias pr-<N>`
      // 得到一个独立的 workers.dev 预览 URL(`pr-<N>-folio-preview.<子域>.workers.dev`),**共用**这一个
      // Worker + 共用 folio-preview D1,互不覆盖。preview_urls 打开版本预览 URL。
      "preview_urls": true,
      "vars": {
        "LOG_LEVEL": "info",
        // 只在 preview 放行的额外可信 origin(better-auth trustedOrigins)。让上面那些 workers.dev
        // 预览别名域也能通过 CSRF/Origin 校验、用密码登录(cookie 默认 host-only,跟着访问域走;
        // passkey rpID 仍绑固定域、换域名不通,预览用密码登录即可)。**生产不设此项 → 严格不放行**。
        // 中间那个 `*` 覆盖账户子域;要更严可改成你自己的 `<子域>`(见 DEPLOY.md 的 PR preview 一节)。
        "PREVIEW_TRUSTED_ORIGINS": "https://*-folio-preview.*.workers.dev"
      },
      "cache": { "enabled": true },
      "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/_serverFn/*", "/cdn-cgi/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "folio-preview",
          // `wrangler d1 create folio-preview` 得到的真实 id,粘到这里(见 DEPLOY.md)。
          "database_id": "3564a2e0-d932-4368-bb3a-40c272ae047f",
          "migrations_dir": "../../packages/db/drizzle"
        }
      ],
      // 运行器:preview 自己的那个(不同 Worker → 不同的 DO 命名空间,与生产互不相干)。没有 cron 往里投,
      // 但手动同步也走它(FOL-89),preview 上那条路得能跑通。
      "durable_objects": {
        "bindings": [{ "name": "JOB_RUNNER", "class_name": "JobRunner" }]
      },
      "observability": { "enabled": true, "head_sampling_rate": 1 }
    }
  }
}
