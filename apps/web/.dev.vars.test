# E2E-only worker env, committed on purpose: every value is fake.
# Active when started with CLOUDFLARE_ENV=test: @cloudflare/vite-plugin then loads only this file
# (when `.dev.vars.<env>` exists, `.dev.vars` is not loaded), so real credentials never reach e2e.
BETTER_AUTH_SECRET=e2e-fake-auth-secret-000000000000
# Must match the Playwright origin verbatim (passkey expectedOrigin); https because vite serves
# a self-signed cert for HTTP/2.
BETTER_AUTH_URL=https://localhost:3100
# 32-byte base64 key (decodes to "e2e-fake-secrets-key-32-bytes!!!").
SECRETS_KEY=ZTJlLWZha2Utc2VjcmV0cy1rZXktMzItYnl0ZXMhISE=
LOG_LEVEL=warning
# Point all Binance hosts at the local fake server (e2e/fixtures/binance-server.mjs).
BINANCE_API_BASE=http://localhost:3099
BINANCE_FAPI_BASE=http://localhost:3099
BINANCE_DAPI_BASE=http://localhost:3099
# CoinGecko goes to the same fake server; otherwise the price job hits the real network and
# blocks the serial local queue.
COINGECKO_API_BASE=http://localhost:3099/coingecko/api/v3
