{
  "name": "folio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "web": "pnpm --filter @folio/web",
    "dev": "pnpm --filter @folio/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:packages": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write --error-on-warnings",
    "knip": "knip",
    "check:catalog": "node scripts/check-catalog.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "knip": "^6.29.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "workerd"
    ]
  }
}
