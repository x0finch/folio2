{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folio-db",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  // Only for this package's migrations and Vitest (Miniflare D1); @folio/db is not a deploy unit.
  // database_id is a placeholder: local apply goes by database_name.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "folio",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
}
