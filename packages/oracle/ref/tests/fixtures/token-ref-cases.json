{
  "_": [
    "Golden table for the tokenRef grammar.",
    "construct: structure in, string out; `value` is the address (contract), id (issued) or name (custom); unused for native.",
    "parse: `parsed` null means unreadable (kind=unknown); `canonical` defaults to raw, else raw is non-canonical.",
    "Every row is checked three ways: parse gives the structure, the semantic form rebuilds to canonical, the two-part form rebuilds to canonical.",
    "All four shapes carry a marker (native is a full reserved word); anything else is unknown, never a trusted bucket."
  ],

  "construct": [
    {
      "note": "EVM contract: hex is case-insensitive, lowercased to a stable key",
      "kind": "contract",
      "namer": "evm:42161",
      "value": "0xaf88d065e77c8cC2239327C5EDb3A432268e5831",
      "ref": "evm:42161/contract:0xaf88d065e77c8cc2239327c5edb3a432268e5831"
    },
    {
      "note": "Solana base58 is case-sensitive: lowercasing yields a nonexistent address, keep as is",
      "kind": "contract",
      "namer": "solana",
      "value": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
      "ref": "solana/contract:EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
    },
    {
      "note": "Sui coin type contains `::`, not EVM, untouched",
      "kind": "contract",
      "namer": "sui",
      "value": "0x2::sui::SUI",
      "ref": "sui/contract:0x2::sui::SUI"
    },
    {
      "note": "non-EVM addresses keep case; the namer itself is always lowercased",
      "kind": "contract",
      "namer": "Solana",
      "value": "0xAbC",
      "ref": "solana/contract:0xAbC"
    },
    {
      "note": "native coin: reserved word, namer normalised",
      "kind": "native",
      "namer": "Bitcoin",
      "ref": "bitcoin/native"
    },
    {
      "note": "surrounding whitespace trimmed",
      "kind": "contract",
      "namer": " evm:1 ",
      "value": " 0xABC ",
      "ref": "evm:1/contract:0xabc"
    },
    {
      "note": "namer-issued id untouched: normalising is the producer's job",
      "kind": "issued",
      "namer": "binance",
      "value": "USDC",
      "ref": "binance/issued:USDC"
    },
    {
      "note": "upstream coin id kept as is (producer normalises lowercase kebab)",
      "kind": "issued",
      "namer": "coingecko",
      "value": "Wrapped-BTC",
      "ref": "coingecko/issued:Wrapped-BTC"
    },
    {
      "note": "caller-made name: the grammar uppercases it, else custom:usdc and custom:USDC would be two rows",
      "kind": "custom",
      "namer": "manual",
      "value": "usdc",
      "ref": "manual/custom:USDC"
    },
    {
      "note": "custom name also trimmed",
      "kind": "custom",
      "namer": "Manual",
      "value": "  my-coin  ",
      "ref": "manual/custom:MY-COIN"
    }
  ],

  "parse": [
    {
      "note": "EVM contract",
      "raw": "evm:42161/contract:0xaf88d065e77c8cc2239327c5edb3a432268e5831",
      "parsed": {
        "kind": "contract",
        "namer": "evm:42161",
        "address": "0xaf88d065e77c8cc2239327c5edb3a432268e5831",
        "localName": "contract:0xaf88d065e77c8cc2239327c5edb3a432268e5831"
      }
    },
    {
      "note": "colons in the namer do not split; the slash does",
      "raw": "evm:1/native",
      "parsed": { "kind": "native", "namer": "evm:1", "localName": "native" }
    },
    {
      "note": "non-EVM native coin",
      "raw": "bitcoin/native",
      "parsed": { "kind": "native", "namer": "bitcoin", "localName": "native" }
    },
    {
      "note": "marker is read by prefix: an address containing `::` is still a contract, not a third part",
      "raw": "sui/contract:0x2::sui::SUI",
      "parsed": {
        "kind": "contract",
        "namer": "sui",
        "address": "0x2::sui::SUI",
        "localName": "contract:0x2::sui::SUI"
      }
    },
    {
      "note": "base58 address kept as is",
      "raw": "solana/contract:EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
      "parsed": {
        "kind": "contract",
        "namer": "solana",
        "address": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
        "localName": "contract:EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
      }
    },
    {
      "note": "upstream coin id: coingecko issues it and vouches for it",
      "raw": "coingecko/issued:usd-coin",
      "parsed": {
        "kind": "issued",
        "namer": "coingecko",
        "id": "usd-coin",
        "localName": "issued:usd-coin"
      }
    },
    {
      "note": "venue listing ticker: case untouched",
      "raw": "binance/issued:USDC",
      "parsed": {
        "kind": "issued",
        "namer": "binance",
        "id": "USDC",
        "localName": "issued:USDC"
      }
    },
    {
      "note": "perp venue likewise",
      "raw": "hyperliquid/issued:BTC",
      "parsed": {
        "kind": "issued",
        "namer": "hyperliquid",
        "id": "BTC",
        "localName": "issued:BTC"
      }
    },
    {
      "note": "user-typed symbol: now has a shape, never mistaken for a namer-issued id",
      "raw": "manual/custom:USDC",
      "parsed": {
        "kind": "custom",
        "namer": "manual",
        "name": "USDC",
        "localName": "custom:USDC"
      }
    },

    {
      "note": "non-canonical: case normalised before parsing, rebuilds to canonical",
      "raw": "EVM:1/CONTRACT:0xAbC",
      "canonical": "evm:1/contract:0xabc",
      "parsed": {
        "kind": "contract",
        "namer": "evm:1",
        "address": "0xabc",
        "localName": "contract:0xabc"
      }
    },
    {
      "note": "reserved word is case-insensitive",
      "raw": "bitcoin/NATIVE",
      "canonical": "bitcoin/native",
      "parsed": { "kind": "native", "namer": "bitcoin", "localName": "native" }
    },
    {
      "note": "marker is case-insensitive; the id after it is untouched (namer's spelling)",
      "raw": "binance/ISSUED:USDC",
      "canonical": "binance/issued:USDC",
      "parsed": {
        "kind": "issued",
        "namer": "binance",
        "id": "USDC",
        "localName": "issued:USDC"
      }
    },
    {
      "note": "custom name uppercased in the grammar, so the parse is already canonical",
      "raw": "manual/custom:usdc",
      "canonical": "manual/custom:USDC",
      "parsed": {
        "kind": "custom",
        "namer": "manual",
        "name": "USDC",
        "localName": "custom:USDC"
      }
    },

    { "note": "empty string", "raw": "", "parsed": null },
    { "note": "whitespace only", "raw": "   ", "parsed": null },
    { "note": "separator only", "raw": "/", "parsed": null },
    { "note": "missing left part", "raw": "/native", "parsed": null },
    { "note": "missing right part", "raw": "bitcoin/", "parsed": null },
    { "note": "no separator", "raw": "evm:1", "parsed": null },
    { "note": "malformed", "raw": "nonsense", "parsed": null },
    {
      "note": "three parts (e.g. NFT tokenId) are meaningless here: not folded into localName",
      "raw": "evm:1/contract:0xabc/1234",
      "parsed": null
    },
    { "note": "three parts", "raw": "a/b/c", "parsed": null },
    { "note": "empty address", "raw": "evm:1/contract:", "parsed": null },
    { "note": "empty after marker: issued likewise", "raw": "binance/issued:", "parsed": null },
    { "note": "empty after marker: custom likewise", "raw": "manual/custom:", "parsed": null },
    {
      "note": "a right part without a marker is always unreadable: the shape of the `manual/USDC` bug",
      "raw": "manual/USDC",
      "parsed": null
    },
    {
      "note": "same shape under another namer: the fallback ignores who speaks",
      "raw": "coingecko/usd-coin",
      "parsed": null
    },
    {
      "note": "legacy `erc20:` grammar rejected, else symbol trust becomes a guess",
      "raw": "evm:1/erc20:0xabc",
      "parsed": null
    },
    { "note": "legacy `token:` grammar", "raw": "solana/token:EPjF", "parsed": null },
    { "note": "legacy `native:` grammar", "raw": "bitcoin/native:btc", "parsed": null },
    {
      "note": "producer-invented marker rejected: markers are the grammar's own constants",
      "raw": "evm:1/spl:0xabc",
      "parsed": null
    },
    { "note": "legacy string without a slash", "raw": "coingecko:usd-coin", "parsed": null }
  ]
}
