{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/web": {
      "ignoreDependencies": ["cloudflare", "tailwindcss", "@tailwindcss/typography"],
      "ignoreBinaries": ["cloudflared"],
      "entry": ["e2e/fixtures/binance-server.mjs"]
    },
    "packages/ui": {
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/db": {
      "ignoreDependencies": ["cloudflare", "wrangler"]
    },
    "packages/connectors/providers/rabby": {
      "ignoreDependencies": ["wrangler"]
    },
    "packages/clients/rabby": {
      "entry": ["vendor/regenerate.mjs"]
    },
    "packages/shared": {
      "ignoreDependencies": ["wrangler"]
    }
  }
}
